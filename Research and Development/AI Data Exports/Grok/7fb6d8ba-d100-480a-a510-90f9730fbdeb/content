# Simulated EEG processing using LLC 1's hybrid SNN/CNN chip
def process_eeg_signal(signal: np.ndarray, hybrid_chip) -> np.ndarray:
    """
    Process EEG signal using hybrid SNN/CNN chip (LLC 1).
    Args:
        signal: Raw EEG data (numpy array)
        hybrid_chip: Simulated hybrid SNN/CNN chip instance
    Returns:
        Processed features for CAPTCHA challenge
    """
    # SNN for temporal processing
    snn_features = hybrid_chip.snn_process(signal, precision="INT4")
    # CNN for spatial feature extraction
    cnn_features = hybrid_chip.cnn_process(snn_features, precision="FP16")
    return cnn_features

